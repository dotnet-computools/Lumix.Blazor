@using Lumix.Blazor.Services
@using Lumix.Blazor.Services.IServices
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<style>
    .mud-button-root.nav-menu-button {
        border-width: 2px !important;
        border-color: orangered !important;
        font-family: 'Sofia', sans-serif;
        font-weight: 400;
        padding-left: 10px;
        padding-right: 10px;
        text-transform: none;
        font-size: 16px;
        box-shadow: none;
    }

    .mud-button-root.login-button {
        color: orangered !important;
        width: 120px;
        height: 38px;
    }

    .mud-button-root.login-button:hover {
        background-color: orangered !important;
        color: black !important;
        border: solid !important;
        border-width: 2px;
        border-color: black;
    }

    .mud-button-root.register-button {
        background-color: orangered !important;
        color: white !important;
        width: 223px;
        height: 38px;
    }

    .mud-button-root.register-button:hover {
        background-color: orangered !important;
        color: black !important;
        border: solid !important;
        border-width: 2px;
        border-color: black;
    }

</style>

@if (!isAuthenticated)
{
    <MudAppBar Elevation="0" Style="background-color: white;">
        <div class="logo-container" @onclick="ToggleDrawer">
            <img src="images/logo.png" alt="logo_icon" />
        </div>

        <MudSpacer />

        <div class="buttons-section">
            <div class="button-container">
                <MudButton Variant="Variant.Outlined" Class="nav-menu-button login-button" Href="/login">
                    Увійти
                </MudButton>
            </div>
            <MudSpacer />
            <div class="button-container">
                <MudButton Variant="Variant.Filled" Class="nav-menu-button register-button" Href="/register">
                    Зареєструватися
                </MudButton>
            </div>
        </div>
    </MudAppBar>
}
else
{
    <MudAppBar Elevation="0" Style="background-color: white;">
        <div class="logo-container" @onclick="ToggleDrawer">
            <img src="images/logo.png" alt="logo_icon" />
        </div>
    </MudAppBar>
    <MudDrawer @bind-Open="IsDrawerOpen"
                Variant="DrawerVariant.Responsive"
                Elevation="0"
                Anchor="Anchor.Start"
                ClipMode="DrawerClipMode.Always">

        <MudNavMenu Class="mt-10">
            <MudStack Row="false" Spacing="2">
                <MudNavLink Href="/" Class="menu-item" Match="NavLinkMatch.All">
                    <img src="images/icons/Home.png" />
                    Стрічка
                </MudNavLink>

                <MudNavLink Href="/search" Class="menu-item">
                    <img src="images/icons/Search.png" />
                    Пошук
                </MudNavLink>

                <MudNavLink Href="/profile" Class="menu-item">
                    <img src="images/icons/User.png" />
                    Профіль
                </MudNavLink>

                <MudNavLink Href="/posts/create" Class="menu-item">
                    <img src="images/icons/Settings.png" />
                    Створити пост
                </MudNavLink>
                <MudNavLink OnClick="HandleLogout" Class="menu-item">
                    <img src="images/icons/Logout.png" />
                    Вийти
                </MudNavLink>
            </MudStack>
        </MudNavMenu>
    </MudDrawer>
}


@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    public bool IsDrawerOpen { get; set; } = false;
    void ToggleDrawer() => IsDrawerOpen = !IsDrawerOpen;
    public bool isAuthenticated { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthStateTask;
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
    }

    private async Task HandleLogout()
    {
        await AuthService.Logout();
        if (AuthStateProvider is CustomAuthenticationStateProvider customAuthStateProvider)
        {
            customAuthStateProvider.NotifyUserAuthenticationStateChanged();
        }
        NavigationManager.NavigateTo("/");
    }
}
