@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

<MudFileUpload T="IBrowserFile"
               FilesChanged="OnFileChanged"
               AppendMultipleFiles="false"
               Accept="image/*"
               HideList="true"
               Context="fileInput">

    <ButtonTemplate>
        <label class="upload-photo-area" for="@fileInput">
        <div class="upload-content">
            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" />
            <div class="upload-content-title">
                @if(@HasPhoto){
                    <text>Фото обрано <br /> щоб обрати інший файл натисніть або перетягніть його сюди</text>
                }else{
                    <text>Оберіть файл з комп'ютера<br />або перетягніть його сюди</text>
                }
            </div>
        </div>

        <div class="upload-content-sub">
            Ми рекомендуємо обирати файли високої якості,<br />
            але не більше 20 МБ
        </div>
        </label>
    </ButtonTemplate>
</MudFileUpload>

@code {
    [Parameter] public EventCallback<IBrowserFile> OnSelected { get; set; }

    [Parameter] public bool HasPhoto { get; set; }

    private Task OnFileChanged(IBrowserFile file)
        => OnSelected.InvokeAsync(file);

}
