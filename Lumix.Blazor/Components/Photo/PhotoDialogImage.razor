@using Lumix.Blazor.Data.Photo

<MudPaper Elevation="0"
          Class="d-flex oi-justify-center oi-align-center h-100 pa-0">

    @if(Photo is null)
    {
        <MudText Color="Color.Error">Фото не знайдено</MudText>
    }
    else
    {
        <MudImage Src="@Photo.Url"
                  Alt="@Photo.Title"
                  Class="photo-dialog-image"/>
    }
</MudPaper>


@code {
    [Parameter] public PhotoDto? Photo { get; set; }
}
