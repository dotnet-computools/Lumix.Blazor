@using Lumix.Blazor.Data
@inherits LayoutComponentBase

<style>
    .profile-container {
        max-width: 600px;
        margin: 0 auto;
    }

    .profile-photo-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
</style>

<MudPaper Class="d-flex flex-column align-items-center pa-6 profile-container">
    <MudAvatar Size="Size.Large"
               Class="mb-3"
               Src="@Profile.ProfilePictureUrl" />
    <MudText Typo="Typo.h6" Class="font-weight-bold text-center">
        @Profile.Username
    </MudText>

    <MudText Typo="Typo.body2" Class="mt-2 text-center">
        @Profile.FollowersCount підписників • @Profile.FollowingCount підписок
    </MudText>

    <MudText Typo="Typo.body2" Class="text-center mb-4">
        Всього @Profile.PhotosCount фото
    </MudText>

    <MudGrid>
        @foreach(var photo in Profile.Photos)
        {
            <MudItem lg="3" md="3" sm="1">
                <img src="@photo.Url" alt="photo" class="profile-photo-img" />
            </MudItem>
        }
    </MudGrid>
</MudPaper>

@code {
    [Parameter] public UserProfileDto Profile { get; set; } = default!;
}
